# ─── TABLE 2 ─────────────────────────────────────────────────────────────────
print("\n" + "=" * 68)
print("TABLE 2: Holonomy floor vs support radius rho  (n=10000)")
print(f"         S^2, kappa=1, r=1, B=1,  {N_TRIALS} independent trials")
print("=" * 68)
print(f"\n  Predicted: Delta_hol = 2*sin(pi*rho^2/2)  [Proposition 1]")
print(f"  Observed : Err(B) at n=10000 -> Delta_hol  (ratio -> 1)\n")

rho_list = [0.3, 0.5, 0.8, 1.0]
T2 = {}
for rho in rho_list:
    T2[rho], _ = run_trial_block(rho, [10000], N_TRIALS)

print(f"  {'rho':>6}  {'Delta_hol':>12}  {'Err(A)':>10}  {'Err(B)':>10}  {'ratio':>8}")
print("  " + "-" * 54)
for rho in rho_list:
    theta = np.pi * rho**2
    dh    = 2 * np.sin(theta / 2)
    eA    = T2[rho][10000]['A']
    eB    = T2[rho][10000]['B']
