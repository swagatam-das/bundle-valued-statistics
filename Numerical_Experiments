print(f"\n  ratio = Err(B)/Delta_hol -> 1 confirms error floor = Delta_hol.")
print(f"  Err(A) -> 0 confirms stochastic term vanishes as n -> inf.")
print(f"  For small rho: Delta_hol ~ pi*rho^2 (rho^2 scaling).")

# ─── crossover summary ────────────────────────────────────────────────────────
print("\n" + "=" * 68)
print("CROSSOVER VERIFICATION")
print("=" * 68)
print(f"\n  n_cross = 1/Delta_hol^2  (equating 1/sqrt(n) with Delta_hol)\n")
print(f"  {'rho':>6}  {'Delta_hol':>12}  {'n_cross':>10}  {'Err(A)@n_cross':>16}")
print("  " + "-" * 50)
