"""
Reproducible experiment for:
  "Sharp Concentration Bounds for Bundle-Valued Statistics on Manifolds"

Verifies the crossover between stochastic error and holonomy-induced
error floor on S^2 (Theorem 3, Proposition 1, Section 6.6/6.7).

Setup
-----
- Base manifold : S^2 (unit sphere, r=1, kappa=1)
- Bundle        : tangent bundle TS^2
- Reference pt  : x0 = north pole = (0,0,1)
- Section       : s(x) = normalised (P_{x0->x}v0 + noise), B=1
                  (random unit tangent field with mean direction v0)
- Transport A   : parallel transport along unique minimising geodesic
                  -> Y_bar^A -> m*  with error ~ 1/sqrt(n)
- Transport B   : same PT composed with holonomy rotation by theta=pi*rho^2
                  -> Y_bar^B -> R_theta m*  with error floor = Delta_hol
                  where Delta_hol = 2*sin(pi*rho^2/2)  [Proposition 1]

Key predictions verified
------------------------
1. Err(A) = ||Y_bar^A - m*|| decays as ~1/sqrt(n)  (stochastic term)
2. Err(B) = ||Y_bar^B - m*|| -> Delta_hol           (holonomy floor)
3. The ratio Err(B)/Delta_hol -> 1 as n grows
4. Delta_hol scales as ~rho^2 for small rho

Author note: Rule B simulates the effect of a second valid geodesic
choice that encloses a spherical cap of area ~pi*rho^2, consistent
with the exact holonomy formula of Proposition 1.
"""

import numpy as np

rng = np.random.default_rng(2024)
x0  = np.array([0., 0., 1.])   # north pole
v0  = np.array([1., 0., 0.])   # reference direction in T_{x0}S^2

# ─── geometry ────────────────────────────────────────────────────────────────

def sample_cap(rho, n):
    """Uniform sample from geodesic ball B(x0, rho) on S^2."""
    pts, need = [], n
    while need > 0:
        v = rng.standard_normal((max(4 * need, 300), 3))
        v /= np.linalg.norm(v, axis=1, keepdims=True)
        v  = v[v[:, 2] >= np.cos(rho)][:need]
        pts.append(v)
        need -= len(v)
    return np.vstack(pts)[:n]


def pt_x_to_x0(xs, vs):
    """
    Parallel transport of vs in T_x S^2 to T_{x0} S^2
    along the minimising geodesic (Rule A, closed form).
    """
    c = np.clip(xs[:, 2], -1., 1.)
    s = np.sqrt(np.maximum(1 - c**2, 0.))
    safe = s > 1e-10
    # geodesic frame at x
    e2 = np.zeros_like(xs)
    e2[safe] = (x0 - c[safe, None] * xs[safe]) / s[safe, None]
    # geodesic frame at x0
    f2 = np.zeros_like(xs)
    f2[safe] = -(xs[safe] - c[safe, None] * x0) / s[safe, None]
    a  = np.sum(vs * xs, axis=1)
    b  = np.sum(vs * e2, axis=1)
    vp = vs - a[:, None] * xs - b[:, None] * e2
    out = a[:, None] * x0 + b[:, None] * f2 + vp
    out[:, 2] = 0.           # project to T_{x0}S^2
    return out


def holonomy_rotate(ys, theta):
    """
    Apply holonomy rotation by angle theta in T_{x0}S^2.
    Simulates the effect of a second geodesic enclosing
    spherical area A = theta * r^2 = theta (r=1).
    """
    c, s = np.cos(theta), np.sin(theta)
    out  = ys.copy()
    out[:, 0] = c * ys[:, 0] - s * ys[:, 1]
    out[:, 1] = s * ys[:, 0] + c * ys[:, 1]
    return out


def make_section(xs, sigma=0.3):
    """
    Random unit tangent section with mean direction v0.
    s(x) = normalise( proj_{T_x}(v0) + Gaussian noise in T_x ).
    """
    # project v0 to T_x S^2
    v_tan  = v0 - np.sum(v0 * xs, axis=1, keepdims=True) * xs
    # tangential Gaussian noise
    noise  = rng.standard_normal(xs.shape)
    noise -= np.sum(noise * xs, axis=1, keepdims=True) * xs
    noise *= sigma / (np.linalg.norm(noise, axis=1, keepdims=True) + 1e-10)
    sec    = v_tan + noise
    # normalise to B=1
    sec   /= np.linalg.norm(sec, axis=1, keepdims=True) + 1e-10
    return sec


def mc_ground_truth(rho, n_mc=200_000):
    """Estimate m* = E[P_{X->x0} s(X)] by Monte Carlo."""
    xs = sample_cap(rho, n_mc)
    vs = make_section(xs)
    return pt_x_to_x0(xs, vs).mean(axis=0)


# ─── experiment ──────────────────────────────────────────────────────────────

def run_trial_block(rho, n_list, n_trials):
    """
    Returns dict: n -> {'A': mean_errA, 'B': mean_errB}
    Err(A): ||Y_bar^A - m*||  (standard PT)
    Err(B): ||Y_bar^B - m*||  (PT + holonomy rotation)
    """
    theta  = np.pi * rho**2          # holonomy angle = area/r^2
    mstar  = mc_ground_truth(rho)
    res    = {n: {'A': [], 'B': []} for n in n_list}

    for _ in range(n_trials):
        xs_big = sample_cap(rho, max(n_list))
        vs_big = make_section(xs_big)
        for n in n_list:
            yA = pt_x_to_x0(xs_big[:n], vs_big[:n])
            yB = holonomy_rotate(yA, theta)
            res[n]['A'].append(np.linalg.norm(yA.mean(0) - mstar))
            res[n]['B'].append(np.linalg.norm(yB.mean(0) - mstar))

    return {n: {k: float(np.mean(v)) for k, v in d.items()}
            for n, d in res.items()}, mstar


# ─── TABLE 1 ─────────────────────────────────────────────────────────────────
N_TRIALS = 300
n_list   = [100, 500, 2000, 10000]

print("=" * 68)
print("TABLE 1: Stochastic error and holonomy floor vs sample size n")
print(f"         S^2, kappa=1, r=1, B=1,  {N_TRIALS} independent trials")
print("=" * 68)
print(f"\n  Err(A) = standard transport error  -> decays as ~1/sqrt(n)")
print(f"  Err(B) = holonomy-rule error        -> floors at Delta_hol")
print(f"  Delta_hol = 2*sin(pi*rho^2/2)  [Proposition 1, sharp formula]\n")

T1 = {}
for rho in [0.5, 1.0]:
    theta = np.pi * rho**2
    dh    = 2 * np.sin(theta / 2)
    T1[rho], mstar = run_trial_block(rho, n_list, N_TRIALS)
    print(f"  rho={rho}  Delta_hol = {dh:.4f}  (theta=pi*rho^2={theta:.3f})")
    print(f"  m* = [{mstar[0]:.4f}, {mstar[1]:.4f}, 0]")
    print(f"  {'n':>8}  {'Err(A)':>10}  {'Err(B)':>10}")
    print("  " + "-" * 32)
    for n in n_list:
        print(f"  {n:>8}  {T1[rho][n]['A']:>10.4f}  {T1[rho][n]['B']:>10.4f}")
    print(f"  {'Delta_hol':>8}  {'--':>10}  {dh:>10.4f}\n")

